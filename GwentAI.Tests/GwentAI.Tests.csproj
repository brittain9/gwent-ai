<Project Sdk="Microsoft.NET.Sdk">
  <!-- Engine-free unit tests for GwentAI code that needs no client:
       dotnet test GwentAI.Tests/GwentAI.Tests.csproj -m:2 -->
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <IsPackable>false</IsPackable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../GwentAI/Learn/TemplateColumns.cs" />
    <Compile Include="../GwentAI/Learn/ValueModel.cs" />
    <Compile Include="../GwentAI/Search/CardRoles.cs" />
    <Compile Include="../GwentAI/Search/ClassB.cs" />
    <Compile Include="../GwentAI/Search/EconomyOrder.cs" />
    <Compile Include="../GwentAI/Search/LowerBoundRule.cs" />
    <Compile Include="../GwentAI/Search/MatchPoint.cs" />
    <Compile Include="../GwentAI/Search/PassRules.cs" />
    <Compile Include="../GwentAI/Search/PriorSample.cs" />
    <Compile Include="../GwentAI/Search/RoundGate.cs" />
    <Compile Include="../GwentAI/Search/SplitMix64.cs" />
    <Compile Include="../GwentAI/Search/RootStat.cs" />
    <Compile Include="../GwentAI/Search/WorkBudget.cs" />
    <Compile Include="../GwentAI/Search/SecondLookChoice.cs" />
    <Content Include="class-b-states.json" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="../data/model/fta.vnet" Link="model-fixtures/shipped-fta.vnet" CopyToOutputDirectory="PreserveNewest" />
    <!-- The fitted nets (with their static columns) are not part of the shipped
         project; the tests that need them skip when they are absent. -->
    <Content Include="../data/eval/fta.vnet" Link="model-fixtures/fta.vnet" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../data/eval/fta.vnet')" />
    <Content Include="../data/eval/fs2.vnet" Link="model-fixtures/fs2.vnet" CopyToOutputDirectory="PreserveNewest" Condition="Exists('../data/eval/fs2.vnet')" />
    <Content Include="../data/cards/roles.json" Link="card-fixtures/roles.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <!-- Numeric ability parameters: client data from the user's client. scripts/answer_kinds.py
       writes one file per roles.json version (.local/cards/answer-params/<sha256 prefix>.json);
       the tests read the one for this checkout's roles.json, when it exists. -->
  <Target Name="CopyAnswerParams" BeforeTargets="PrepareForBuild">
    <GetFileHash Files="$(MSBuildProjectDirectory)/../data/cards/roles.json" Algorithm="SHA256" HashEncoding="hex">
      <Output TaskParameter="Hash" PropertyName="RolesHash" />
    </GetFileHash>
    <PropertyGroup>
      <AnswerParamsFile>$(MSBuildProjectDirectory)/../.local/cards/answer-params/$(RolesHash.ToLowerInvariant().Substring(0, 16)).json</AnswerParamsFile>
    </PropertyGroup>
    <ItemGroup>
      <Content Include="$(AnswerParamsFile)" Link="card-fixtures/answer-params.json" CopyToOutputDirectory="PreserveNewest" Condition="Exists('$(AnswerParamsFile)')" />
    </ItemGroup>
  </Target>
</Project>
