<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <DebugType>none</DebugType>
    <TargetFramework>net35</TargetFramework>
    <LangVersion>latest</LangVersion>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <AutomaticallyUseReferenceAssemblyPackages>false</AutomaticallyUseReferenceAssemblyPackages>
    <ClientDir Condition="'$(ClientDir)' == ''">$(MSBuildProjectDirectory)/../../client</ClientDir>
    <FrameworkPathOverride>$(ClientDir)/Gwent_Data/Managed</FrameworkPathOverride>
    <EnableFrameworkPathOverride>true</EnableFrameworkPathOverride>
    <NoStdLib>true</NoStdLib>
    <!-- The client's assemblies are all referenced below and none is copied
         beside the mod. -->
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <LoaderDir Condition="'$(LoaderDir)' == ''">$(MSBuildProjectDirectory)/../.local/melonloader/MelonLoader</LoaderDir>
    <OutputPath>../dist/</OutputPath>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <Deterministic>true</Deterministic>
    <Nullable>disable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Reference Private="false" Include="$(ClientDir)/Gwent_Data/Managed/*.dll" />
    <Reference Private="false" Include="$(LoaderDir)/MelonLoader.dll" />
    <Reference Private="false" Include="$(LoaderDir)/0Harmony.dll" />
  </ItemGroup>
  <!-- Practice reads the evaluator and the policy prior from the mod itself;
       the prior's card columns are zeroed and filled from the client at load
       time (PolicyModel). -->
  <ItemGroup>
    <EmbeddedResource Include="../data/eval/round.json" LogicalName="eval/round.json" />
    <EmbeddedResource Include="../data/model/pol2.pnet" LogicalName="eval/policy.pnet" />
  </ItemGroup>

</Project>
